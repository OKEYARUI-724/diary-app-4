<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#e7dfe7" />
  <title>Photo Diary | Muted Memories</title>
  <style>
:root {
  font-family: Inter, "Noto Sans JP", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #3f3a40;
  background: #eee9e5;
  --ink: #3f3a40;
  --ink-soft: #756d73;
  --line: rgba(103, 91, 99, .14);
  --paper: rgba(255, 252, 249, .76);
  --paper-strong: rgba(255, 253, 251, .94);
  --lavender: #a99ab6;
  --sage: #9daea3;
  --rose: #c3a0a4;
  --sand: #c8b39d;
  --mist: #b6b8c6;
  --gradient: linear-gradient(135deg, #a99ab6 0%, #9daea3 48%, #c4a0a5 100%);
  --gradient-soft: linear-gradient(135deg, rgba(169,154,182,.22), rgba(157,174,163,.20), rgba(196,160,165,.24));
  --shadow: 0 24px 70px rgba(84, 72, 80, .12);
}

* { box-sizing: border-box; }
html { min-height: 100%; }
body {
  min-height: 100vh;
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 8% 5%, rgba(190, 172, 193, .48) 0, rgba(190, 172, 193, 0) 34%),
    radial-gradient(circle at 90% 18%, rgba(168, 187, 173, .43) 0, rgba(168, 187, 173, 0) 31%),
    radial-gradient(circle at 70% 90%, rgba(201, 166, 166, .38) 0, rgba(201, 166, 166, 0) 33%),
    linear-gradient(145deg, #efeae7 0%, #e9e8e2 48%, #eee6e6 100%);
  color: var(--ink);
}
body.modal-open { overflow: hidden; }
button, input, textarea { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: wait; opacity: .62; }
svg { display: block; }

.ambient {
  position: fixed;
  z-index: -1;
  border-radius: 999px;
  filter: blur(10px);
  opacity: .65;
  pointer-events: none;
}
.ambient-a { width: 260px; height: 260px; top: 14%; left: -100px; background: rgba(167, 151, 181, .24); }
.ambient-b { width: 320px; height: 320px; top: 52%; right: -150px; background: rgba(151, 174, 160, .22); }
.ambient-c { width: 230px; height: 230px; bottom: -60px; left: 35%; background: rgba(194, 155, 160, .20); }

.shell {
  width: min(780px, calc(100% - 32px));
  margin: 44px auto 86px;
  display: grid;
  gap: 40px;
}

.card,
.post {
  border: 1px solid rgba(255,255,255,.64);
  background: var(--paper);
  backdrop-filter: blur(22px) saturate(115%);
  -webkit-backdrop-filter: blur(22px) saturate(115%);
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,.7);
}
.card {
  position: relative;
  overflow: hidden;
  border-radius: 32px;
  padding: 30px;
}
.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 5px;
  background: var(--gradient);
  opacity: .72;
}

.headline, .feed-title, .music-box-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.headline { align-items: flex-start; }
.headline-copy { min-width: 0; }
.headline-kicker { display: inline-flex; align-items: center; gap: 8px; }
h1, h2, p { margin-top: 0; }
h1 {
  margin: 4px 0 0;
  font-size: clamp(28px, 5vw, 42px);
  line-height: 1.18;
  letter-spacing: -.045em;
  color: #373238;
}
h2 {
  margin-bottom: 0;
  font-size: 25px;
  letter-spacing: -.03em;
}
.lead { margin: 10px 0 0; color: #80767c; font-size: 14px; line-height: 1.7; }
.eyebrow {
  margin: 0;
  color: #867a82;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .21em;
}

.gradient-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border: 1px solid rgba(255,255,255,.56);
  border-radius: 13px;
  background: var(--gradient);
  box-shadow: 0 8px 24px rgba(116, 94, 110, .19), inset 0 1px 0 rgba(255,255,255,.34);
}
.gradient-icon svg { width: 20px; height: 20px; fill: rgba(255,255,255,.94); }
.gradient-icon-sm { width: 27px; height: 27px; border-radius: 9px; }
.gradient-icon-sm svg { width: 14px; height: 14px; }
.gradient-icon-xs { width: 24px; height: 24px; border-radius: 8px; }
.gradient-icon-xs svg { width: 13px; height: 13px; }

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border: 1px solid rgba(255,255,255,.58);
  border-radius: 999px;
  background: rgba(255,255,255,.48);
  color: #655d63;
  box-shadow: 0 8px 24px rgba(83,72,79,.07);
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
}
.pill-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gradient);
  box-shadow: 0 0 0 4px rgba(169,154,182,.13);
}

#postForm { display: grid; gap: 19px; margin-top: 26px; }
.field { display: grid; gap: 9px; font-size: 13px; font-weight: 800; color: #5b5258; }
.field-label { display: flex; align-items: center; gap: 8px; }
input, textarea {
  width: 100%;
  border: 1px solid rgba(111, 98, 106, .16);
  background: rgba(255,255,255,.67);
  color: var(--ink);
  border-radius: 17px;
  padding: 14px 15px;
  outline: none;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
  transition: border-color .18s ease, box-shadow .18s ease, background .18s ease, transform .18s ease;
}
input::placeholder, textarea::placeholder { color: #9a9297; }
input:focus, textarea:focus {
  border-color: rgba(154, 137, 167, .48);
  background: rgba(255,255,255,.88);
  box-shadow: 0 0 0 4px rgba(169,154,182,.12), inset 0 1px 0 rgba(255,255,255,.8);
}
textarea { min-height: 98px; resize: vertical; line-height: 1.7; }
input[type="file"] { padding: 11px; }
input[type="file"]::file-selector-button {
  margin-right: 11px;
  border: 0;
  border-radius: 11px;
  padding: 9px 13px;
  background: var(--gradient-soft);
  color: #61565e;
  font-weight: 800;
  cursor: pointer;
}

.preview-wrap, .post-image-wrap {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.7);
  border-radius: 25px;
  background: linear-gradient(135deg, #ded8dd, #dce2dd);
  box-shadow: 0 18px 45px rgba(74, 63, 71, .11);
}
.preview-wrap > img, .post-image { display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; }

.music-box {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(126, 110, 120, .12);
  border-radius: 24px;
  padding: 18px;
  background:
    linear-gradient(135deg, rgba(183,166,191,.14), rgba(165,186,172,.13) 52%, rgba(202,168,171,.15)),
    rgba(255,255,255,.48);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
}
.music-box::after {
  content: "";
  position: absolute;
  width: 110px;
  height: 110px;
  right: -48px;
  top: -48px;
  border-radius: 50%;
  background: rgba(174,158,188,.13);
  pointer-events: none;
}
.music-box-title { position: relative; z-index: 1; }
.section-label { display: flex; align-items: center; gap: 10px; font-size: 15px; color: #4f474d; }
.search-row { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr auto; gap: 9px; margin-top: 14px; }
.search-input-wrap { position: relative; }
.search-input-wrap input { padding-left: 42px; }
.search-icon {
  position: absolute;
  z-index: 2;
  left: 14px;
  top: 50%;
  width: 18px;
  height: 18px;
  transform: translateY(-50%);
  fill: none;
  stroke: #968a92;
  stroke-width: 2;
  stroke-linecap: round;
  pointer-events: none;
}

.primary, .secondary {
  border: 0;
  border-radius: 16px;
  padding: 13px 17px;
  font-weight: 900;
  transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
}
.primary:hover, .secondary:hover, .track button:hover { transform: translateY(-1px); }
.primary:active, .secondary:active, .track button:active { transform: translateY(0); }
.primary {
  min-height: 52px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  background: var(--gradient);
  color: #fff;
  box-shadow: 0 14px 32px rgba(120, 100, 114, .24), inset 0 1px 0 rgba(255,255,255,.25);
}
.primary:hover { box-shadow: 0 16px 36px rgba(120, 100, 114, .3); filter: saturate(105%); }
.button-icon svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.secondary {
  min-width: 74px;
  border: 1px solid rgba(255,255,255,.57);
  background: rgba(255,255,255,.62);
  color: #5f565c;
  box-shadow: 0 8px 20px rgba(91,75,84,.08);
}
.text-button {
  border: 0;
  border-radius: 999px;
  padding: 7px 10px;
  background: rgba(255,255,255,.45);
  color: #7c6f77;
  font-size: 11px;
  font-weight: 800;
}

.muted { position: relative; z-index: 1; color: #82777e; font-size: 12px; margin: 12px 0 0; line-height: 1.65; }
.music-results { position: relative; z-index: 1; display: grid; gap: 9px; margin-top: 13px; max-height: 390px; overflow: auto; padding-right: 2px; }
.music-results::-webkit-scrollbar { width: 7px; }
.music-results::-webkit-scrollbar-track { background: transparent; }
.music-results::-webkit-scrollbar-thumb { border-radius: 999px; background: rgba(124,111,119,.2); }
.track {
  display: grid;
  grid-template-columns: 92px 1fr auto;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border: 1px solid rgba(123,109,118,.12);
  background: rgba(255,255,255,.66);
  border-radius: 17px;
  box-shadow: 0 7px 18px rgba(81,67,76,.05);
  transition: transform .16s ease, background .16s ease, box-shadow .16s ease;
}
.track:hover { transform: translateY(-1px); background: rgba(255,255,255,.84); box-shadow: 0 10px 24px rgba(81,67,76,.09); }
.track > img, .thumb-placeholder { width: 92px; height: 52px; object-fit: cover; border-radius: 11px; background: linear-gradient(135deg,#d8cfd8,#d3ddd6); }
.track-meta { min-width: 0; }
.track-title { color: #4f474d; font-weight: 900; font-size: 13px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.track-artist { margin-top: 3px; font-size: 11px; color: #8a7f85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.track-link { display: inline-block; margin-top: 5px; color: #81727d; font-size: 10px; text-decoration: none; border-bottom: 1px solid rgba(129,114,125,.3); }
.track button {
  border: 0;
  border-radius: 12px;
  padding: 9px 11px;
  background: linear-gradient(135deg, #a99ab6, #9daea3);
  color: #fff;
  box-shadow: 0 8px 18px rgba(112,94,106,.18);
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
  transition: transform .16s ease, box-shadow .16s ease;
}

.music-overlay {
  position: absolute;
  left: 15px;
  right: 15px;
  bottom: 15px;
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 61px;
  padding: 10px 12px;
  border: 1px solid rgba(255,255,255,.28);
  border-radius: 18px;
  background:
    linear-gradient(135deg, rgba(103,88,105,.68), rgba(87,106,98,.67) 52%, rgba(130,95,101,.66));
  backdrop-filter: blur(17px) saturate(125%);
  -webkit-backdrop-filter: blur(17px) saturate(125%);
  color: #fff;
  text-decoration: none;
  box-shadow: 0 12px 34px rgba(49,41,47,.24), inset 0 1px 0 rgba(255,255,255,.22);
}
.music-overlay::before {
  content: "♪";
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 10px;
  background: rgba(255,255,255,.17);
  font-weight: 900;
}
.music-overlay img { width: 62px; height: 35px; object-fit: cover; border-radius: 9px; flex: 0 0 auto; }
.music-overlay .meta { min-width: 0; display: block; text-align: left; }
.music-overlay .title { display: block; font-weight: 900; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.music-overlay .artist { display: block; color: rgba(255,255,255,.72); font-size: 10px; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.music-play-button { width: auto; }
.music-play-button:hover { filter: brightness(1.04); }

.feed { display: grid; gap: 23px; margin-top: 17px; }
.post { border-radius: 28px; padding: 12px; }
.post-body { padding: 15px 10px 9px; }
.post-caption { margin: 0; color: #51494f; line-height: 1.75; font-size: 14px; }
.post-date { margin: 9px 0 0; color: #9a8f95; font-size: 10px; }
.empty {
  border: 1px dashed rgba(118,104,113,.2);
  border-radius: 22px;
  padding: 34px 14px;
  background: rgba(255,255,255,.32);
  color: #887d83;
  text-align: center;
  font-size: 13px;
}

.player-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(49,43,47,.68);
  backdrop-filter: blur(9px);
}
.player-dialog {
  width: min(880px, 100%);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 24px;
  background: #292629;
  color: #fff;
  box-shadow: 0 34px 110px rgba(31,26,29,.48);
}
.player-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 16px; }
.player-bar strong { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player-bar button { width: 36px; height: 36px; border: 1px solid rgba(255,255,255,.08); border-radius: 999px; background: rgba(255,255,255,.08); color: #fff; flex: 0 0 auto; }
.player-frame-wrap { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; }
.player-frame-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.youtube-link { display: block; padding: 13px 16px 16px; color: #e7dde5; font-size: 12px; text-align: right; }
.hidden { display: none !important; }

@media (max-width: 560px) {
  .shell { width: min(100% - 18px, 780px); margin: 14px auto 55px; gap: 28px; }
  .card { padding: 20px; border-radius: 25px; }
  .headline { align-items: flex-start; }
  h1 { font-size: 29px; }
  .lead { font-size: 12px; }
  .pill { display: none; }
  .search-row { grid-template-columns: 1fr; }
  .secondary { width: 100%; }
  .track { grid-template-columns: 82px 1fr; }
  .track > img, .thumb-placeholder { width: 82px; height: 46px; }
  .track button { grid-column: 1 / -1; }
  .music-overlay { left: 10px; right: 10px; bottom: 10px; padding: 9px 10px; }
  .music-overlay::before { display: none; }
  .player-modal { padding: 8px; }
  .player-dialog { border-radius: 17px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
}


/* ===== Muted Gradient UI v2 ===== */
:root {
  --ink: #3d3940;
  --ink-soft: #756e78;
  --paper: rgba(255, 253, 252, .76);
  --paper-strong: rgba(255, 254, 253, .94);
  --lavender: #a99bb9;
  --sage: #9eafa4;
  --rose: #c69da8;
  --sand: #cab9a5;
  --gradient: linear-gradient(120deg, #a99bb9 0%, #b49eae 31%, #c69da8 58%, #9eafa4 100%);
  --gradient-soft: linear-gradient(120deg, rgba(169,155,185,.30), rgba(198,157,168,.24), rgba(158,175,164,.28));
  --shadow: 0 22px 60px rgba(89, 72, 86, .13);
}

html { background: #e9e4e5; }
body {
  background:
    radial-gradient(circle at 5% 4%, rgba(179, 159, 190, .64) 0 9%, rgba(179, 159, 190, 0) 31%),
    radial-gradient(circle at 94% 13%, rgba(158, 183, 166, .55) 0 8%, rgba(158, 183, 166, 0) 30%),
    radial-gradient(circle at 81% 86%, rgba(204, 158, 170, .54) 0 10%, rgba(204, 158, 170, 0) 31%),
    radial-gradient(circle at 18% 88%, rgba(204, 187, 166, .44) 0 8%, rgba(204, 187, 166, 0) 28%),
    linear-gradient(145deg, #eee8eb 0%, #e7e8e2 48%, #eee4e6 100%);
  background-attachment: fixed;
}
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  pointer-events: none;
  opacity: .26;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.10'/%3E%3C/svg%3E");
}

.ambient { filter: blur(24px); opacity: .8; }
.ambient-a { background: rgba(168, 145, 183, .40); }
.ambient-b { background: rgba(140, 174, 153, .34); }
.ambient-c { background: rgba(198, 145, 161, .34); }

.shell { width: min(820px, calc(100% - 32px)); margin-top: 56px; gap: 48px; }
.card,
.post {
  border: 1px solid rgba(255,255,255,.72);
  background: linear-gradient(145deg, rgba(255,255,255,.78), rgba(255,249,250,.60));
  backdrop-filter: blur(28px) saturate(125%);
  -webkit-backdrop-filter: blur(28px) saturate(125%);
  box-shadow: 0 28px 80px rgba(79,65,77,.14), inset 0 1px 0 rgba(255,255,255,.90);
}
.card { border-radius: 38px; padding: 34px; }
.card::before {
  height: 7px;
  opacity: 1;
  background: var(--gradient);
}
.card::after {
  content: "";
  position: absolute;
  width: 230px;
  height: 230px;
  border-radius: 50%;
  right: -120px;
  top: -120px;
  background: radial-gradient(circle, rgba(184,157,190,.26), rgba(184,157,190,0) 68%);
  pointer-events: none;
}

h1 { font-size: clamp(34px, 6vw, 50px); line-height: 1.08; letter-spacing: -.055em; }
.headline-accent {
  display: inline-block;
  background: var(--gradient);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.lead { margin-top: 14px; font-size: 14px; }
.eyebrow { color: #796c78; }
.pill {
  padding: 10px 14px;
  background: rgba(255,255,255,.58);
  border-color: rgba(255,255,255,.84);
  box-shadow: 0 10px 28px rgba(80,64,77,.09);
}
.pill-dot { background: var(--gradient); }

.gradient-icon {
  background: var(--gradient);
  border-color: rgba(255,255,255,.72);
  box-shadow: 0 10px 28px rgba(116,91,110,.25), inset 0 1px 0 rgba(255,255,255,.4);
}

input, textarea {
  background: rgba(255,255,255,.72);
  border-color: rgba(105,89,101,.12);
  border-radius: 20px;
  box-shadow: 0 7px 24px rgba(77,64,73,.035), inset 0 1px 0 rgba(255,255,255,.88);
}
input:focus, textarea:focus {
  transform: translateY(-1px);
  border-color: rgba(165,139,165,.55);
  box-shadow: 0 0 0 5px rgba(174,149,178,.12), 0 10px 30px rgba(80,63,76,.06);
}
input[type="file"]::file-selector-button {
  background: var(--gradient-soft);
  border: 1px solid rgba(255,255,255,.62);
}

.preview-wrap, .post-image-wrap {
  border-radius: 30px;
  box-shadow: 0 24px 50px rgba(72,59,69,.15);
}

.music-box {
  border-radius: 28px;
  border: 1px solid rgba(255,255,255,.72);
  background:
    radial-gradient(circle at 10% 10%, rgba(180,155,192,.20), transparent 38%),
    radial-gradient(circle at 90% 80%, rgba(153,181,163,.20), transparent 37%),
    linear-gradient(135deg, rgba(255,255,255,.66), rgba(255,248,250,.52));
  box-shadow: 0 16px 40px rgba(82,66,78,.08), inset 0 1px 0 rgba(255,255,255,.88);
}
.music-box::after { background: rgba(194,154,170,.18); }

.primary {
  min-height: 58px;
  border-radius: 20px;
  background: var(--gradient);
  box-shadow: 0 16px 36px rgba(122,95,116,.28), inset 0 1px 0 rgba(255,255,255,.28);
}
.primary:hover { transform: translateY(-2px); box-shadow: 0 20px 42px rgba(122,95,116,.34); }
.secondary {
  border-radius: 18px;
  background: rgba(255,255,255,.70);
}

.track {
  border-radius: 20px;
  border-color: rgba(255,255,255,.74);
  background: rgba(255,255,255,.66);
}
.track:hover { background: rgba(255,255,255,.90); transform: translateY(-2px); }
.track button { background: linear-gradient(135deg,#a999b9,#c59ca8 56%,#9eafa4); }

.music-overlay {
  border-radius: 21px;
  background: linear-gradient(120deg, rgba(88,72,91,.86), rgba(113,82,97,.82) 48%, rgba(72,99,85,.84));
  box-shadow: 0 14px 36px rgba(44,34,42,.28), inset 0 1px 0 rgba(255,255,255,.24);
}

.feed-title { padding: 0 8px; }
.post { border-radius: 34px; padding: 13px; }
.post-body { padding: 18px 12px 11px; }
.empty { background: rgba(255,255,255,.45); border-color: rgba(117,99,111,.18); }

@media (max-width: 560px) {
  .shell { width: min(100% - 16px, 820px); margin-top: 12px; }
  .card { border-radius: 29px; padding: 21px; }
  h1 { font-size: 32px; }
  .music-box { border-radius: 23px; }
  .post { border-radius: 27px; }
}
/* ===== end Muted Gradient UI v2 ===== */

</style>
</head>
<body>
<style id="home-back-link-patch">
.home-back-link{position:fixed;top:18px;left:18px;z-index:1200;display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid rgba(255,255,255,.72);border-radius:999px;background:rgba(255,252,249,.82);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 10px 28px rgba(84,72,80,.13);color:#514951;text-decoration:none;font-size:12px;font-weight:900}.home-back-link:hover{transform:translateY(-1px)}@media(max-width:560px){.home-back-link{top:10px;left:10px;padding:9px 12px}}
</style>
<a class="home-back-link" href="/">&larr; Home</a>

  <div class="ambient ambient-a" aria-hidden="true"></div>
  <div class="ambient ambient-b" aria-hidden="true"></div>
  <div class="ambient ambient-c" aria-hidden="true"></div>

  <main class="shell">
    <section class="composer card">
      <div class="headline">
        <div class="headline-copy">
          <div class="headline-kicker">
            <span class="gradient-icon gradient-icon-sm" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 17.5A3.5 3.5 0 1 0 11 17.5V7.8l8-1.8v7A3.5 3.5 0 1 0 21 16.2V3.5L9 6.2v8A3.5 3.5 0 0 0 4 17.5Z"/></svg>
            </span>
            <p class="eyebrow">MUTED MEMORY</p>
          </div>
          <h1>今日の景色に、<span class="headline-accent">音楽を。</span></h1>
          <p class="lead">写真と音楽を、やさしい色の記憶として残そう。</p>
        </div>
        <span class="pill">
          <span class="pill-dot"></span>
          YouTube Music
        </span>
      </div>

      <form id="postForm">
        <label class="field upload-field">
          <span class="field-label">
            <span class="gradient-icon gradient-icon-xs" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 18.5v-13Zm3 11.9h10l-3.2-4-2.4 2.8-1.7-2-2.7 3.2ZM15.8 9A1.8 1.8 0 1 0 15.8 5.4 1.8 1.8 0 0 0 15.8 9Z"/></svg>
            </span>
            写真
          </span>
          <input id="image" name="image" type="file" accept="image/*" required />
        </label>

        <div id="previewWrap" class="preview-wrap hidden">
          <img id="imagePreview" alt="投稿画像プレビュー" />
          <div id="musicOverlay" class="music-overlay hidden"></div>
        </div>

        <label class="field">
          <span class="field-label">
            <span class="gradient-icon gradient-icon-xs" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5.5 4h13A2.5 2.5 0 0 1 21 6.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-5.6 4v-4.2A2.5 2.5 0 0 1 3 14.5v-8A2.5 2.5 0 0 1 5.5 4Z"/></svg>
            </span>
            ひとこと
          </span>
          <textarea name="caption" rows="3" placeholder="今日の思い出を書いてみよう"></textarea>
        </label>

        <div class="music-box">
          <div class="music-box-title">
            <strong class="section-label">
              <span class="gradient-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 17.5A3.5 3.5 0 1 0 11 17.5V7.8l8-1.8v7A3.5 3.5 0 1 0 21 16.2V3.5L9 6.2v8A3.5 3.5 0 0 0 4 17.5Z"/></svg>
              </span>
              音楽を追加
            </strong>
            <button type="button" id="clearMusic" class="text-button hidden">選択解除</button>
          </div>
          <div class="search-row">
            <div class="search-input-wrap">
              <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m20 20-4.4-4.4m2.4-5.1a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"/></svg>
              <input id="musicQuery" type="search" placeholder="曲名・アーティスト名で検索" />
            </div>
            <button type="button" id="searchMusic" class="secondary">検索</button>
          </div>
          <p id="musicMessage" class="muted">YouTubeから曲やMVを検索して、この日の1曲として残せます。</p>
          <div id="musicResults" class="music-results"></div>
        </div>

        <button type="submit" class="primary">
          <span class="button-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 18v1.5A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V18"/></svg>
          </span>
          投稿する
        </button>
      </form>
    </section>

    <section>
      <div class="feed-title">
        <div>
          <div class="headline-kicker">
            <span class="gradient-icon gradient-icon-sm" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11Zm4.2 8.7 2.6-3 2.2 2.5 2.1-2.3 2.7 3.1H8.2Z"/></svg>
            </span>
            <p class="eyebrow">MEMORIES</p>
          </div>
          <h2>最近の投稿</h2>
        </div>
      </div>
      <div id="feed" class="feed"></div>
    </section>
  </main>

  <div id="playerModal" class="player-modal hidden" role="dialog" aria-modal="true" aria-label="YouTube player">
    <div class="player-dialog">
      <div class="player-bar">
        <strong id="playerTitle">YouTubeで再生</strong>
        <button type="button" id="closePlayer" aria-label="閉じる">✕</button>
      </div>
      <div class="player-frame-wrap">
        <iframe
          id="youtubePlayer"
          title="YouTube video player"
          src=""
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <a id="openYouTube" class="youtube-link" href="#" target="_blank" rel="noopener noreferrer">YouTubeで開く ↗</a>
    </div>
  </div>

  <script>
const postForm = document.getElementById("postForm");
const imageInput = document.getElementById("image");
const imagePreview = document.getElementById("imagePreview");
const previewWrap = document.getElementById("previewWrap");
const musicOverlay = document.getElementById("musicOverlay");
const musicQuery = document.getElementById("musicQuery");
const searchMusicButton = document.getElementById("searchMusic");
const musicResults = document.getElementById("musicResults");
const musicMessage = document.getElementById("musicMessage");
const clearMusicButton = document.getElementById("clearMusic");
const feed = document.getElementById("feed");
const playerModal = document.getElementById("playerModal");
const youtubePlayer = document.getElementById("youtubePlayer");
const closePlayerButton = document.getElementById("closePlayer");
const playerTitle = document.getElementById("playerTitle");
const openYouTube = document.getElementById("openYouTube");

let selectedVideo = null;
let currentPreviewUrl = null;

imageInput.addEventListener("change", () => {
  const file = imageInput.files?.[0];
  if (!file) return;

  if (currentPreviewUrl) URL.revokeObjectURL(currentPreviewUrl);
  currentPreviewUrl = URL.createObjectURL(file);
  imagePreview.src = currentPreviewUrl;
  previewWrap.classList.remove("hidden");
  renderSelectedMusic();
});

searchMusicButton.addEventListener("click", searchMusic);
musicQuery.addEventListener("keydown", (event) => {
  if (event.key === "Enter") {
    event.preventDefault();
    searchMusic();
  }
});

clearMusicButton.addEventListener("click", () => {
  selectedVideo = null;
  clearMusicButton.classList.add("hidden");
  musicMessage.textContent = "音楽の選択を解除しました。";
  renderSelectedMusic();
});

closePlayerButton.addEventListener("click", closePlayer);
playerModal.addEventListener("click", (event) => {
  if (event.target === playerModal) closePlayer();
});
document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && !playerModal.classList.contains("hidden")) {
    closePlayer();
  }
});

async function searchMusic() {
  const q = musicQuery.value.trim();
  if (!q) {
    musicMessage.textContent = "曲名かアーティスト名を入力してください。";
    return;
  }

  searchMusicButton.disabled = true;
  musicMessage.textContent = "YouTubeで検索中...";
  musicResults.innerHTML = "";

  try {
    const response = await fetch(`/api/music/search?q=${encodeURIComponent(q)}&limit=10`);
    const data = await response.json();
    if (!response.ok) throw new Error(data.detail || "検索に失敗しました。");

    musicMessage.textContent = data.items.length
      ? `${data.items.length}件見つかりました。動画を確認して1曲選んでください。`
      : "見つかりませんでした。別の曲名やアーティスト名で試してください。";

    data.items.forEach((video) => {
      const row = document.createElement("div");
      row.className = "track";
      row.innerHTML = `
        ${video.cover_url ? `<img src="${escapeHtml(video.cover_url)}" alt="">` : `<div class="thumb-placeholder"></div>`}
        <div class="track-meta">
          <div class="track-title">${escapeHtml(video.title || "")}</div>
          <div class="track-artist">${escapeHtml(video.artist || "")}</div>
          <a class="track-link" href="${escapeHtml(video.external_url || "#")}" target="_blank" rel="noopener noreferrer">YouTubeで確認 ↗</a>
        </div>
        <button type="button">この曲を選ぶ</button>
      `;
      row.querySelector("button").addEventListener("click", () => {
        selectedVideo = video;
        musicMessage.textContent = `選択中：${decodeEntities(video.title || "")} — ${decodeEntities(video.artist || "")}`;
        clearMusicButton.classList.remove("hidden");
        renderSelectedMusic();
      });
      musicResults.appendChild(row);
    });
  } catch (error) {
    musicMessage.textContent = error.message;
  } finally {
    searchMusicButton.disabled = false;
  }
}

function renderSelectedMusic() {
  if (!selectedVideo || previewWrap.classList.contains("hidden")) {
    musicOverlay.classList.add("hidden");
    musicOverlay.innerHTML = "";
    return;
  }

  musicOverlay.classList.remove("hidden");
  musicOverlay.innerHTML = `
    ${selectedVideo.cover_url ? `<img src="${escapeHtml(selectedVideo.cover_url)}" alt="">` : ""}
    <div class="meta">
      <div class="title">${escapeHtml(decodeEntities(selectedVideo.title || ""))}</div>
      <div class="artist">${escapeHtml(decodeEntities(selectedVideo.artist || ""))} · YouTube</div>
    </div>
  `;
}

postForm.addEventListener("submit", async (event) => {
  event.preventDefault();
  const submitButton = postForm.querySelector('button[type="submit"]');
  submitButton.disabled = true;
  submitButton.textContent = "投稿中...";

  try {
    const formData = new FormData(postForm);
    if (selectedVideo) {
      formData.append("youtube_video_id", selectedVideo.youtube_video_id || "");
    }

    const response = await fetch("/api/posts", { method: "POST", body: formData });
    const data = await response.json();
    if (!response.ok) throw new Error(data.detail || "投稿に失敗しました。");

    postForm.reset();
    selectedVideo = null;
    previewWrap.classList.add("hidden");
    musicOverlay.classList.add("hidden");
    musicResults.innerHTML = "";
    clearMusicButton.classList.add("hidden");
    musicMessage.textContent = "投稿しました。次の思い出にも音楽を付けられます。";
    if (currentPreviewUrl) {
      URL.revokeObjectURL(currentPreviewUrl);
      currentPreviewUrl = null;
    }
    await loadPosts();
  } catch (error) {
    alert(error.message);
  } finally {
    submitButton.disabled = false;
    submitButton.textContent = "投稿する";
  }
});

async function loadPosts() {
  try {
    const response = await fetch("/api/posts");
    const posts = await response.json();
    if (!response.ok) throw new Error(posts.detail || "投稿の取得に失敗しました。");

    feed.innerHTML = "";

    if (!posts.length) {
      feed.innerHTML = '<div class="empty">まだ投稿がありません。最初の1枚を残してみよう。</div>';
      return;
    }

    posts.forEach((post) => {
      const article = document.createElement("article");
      article.className = "post";
      const music = post.music;
      const musicMarkup = music ? `
        <button
          type="button"
          class="music-overlay music-play-button"
          data-video-id="${escapeHtml(music.youtube_video_id || "")}"
          data-title="${escapeHtml(music.title || "")}"
          data-url="${escapeHtml(music.external_url || "")}">
          ${music.cover_url ? `<img src="${escapeHtml(music.cover_url)}" alt="">` : ""}
          <span class="meta">
            <span class="title">${escapeHtml(decodeEntities(music.title || ""))}</span>
            <span class="artist">${escapeHtml(decodeEntities(music.artist || ""))} · YouTube</span>
          </span>
        </button>` : "";

      article.innerHTML = `
        <div class="post-image-wrap">
          <img class="post-image" src="${escapeHtml(post.image_url)}" alt="投稿画像">
          ${musicMarkup}
        </div>
        <div class="post-body">
          ${post.caption ? `<p class="post-caption">${escapeHtml(post.caption)}</p>` : ""}
          <p class="post-date">${formatDate(post.created_at)}</p>
        </div>
      `;

      const playButton = article.querySelector(".music-play-button");
      if (playButton) {
        playButton.addEventListener("click", () => {
          openPlayer(
            playButton.dataset.videoId,
            decodeEntities(playButton.dataset.title || "YouTube"),
            playButton.dataset.url
          );
        });
      }

      feed.appendChild(article);
    });
  } catch (error) {
    feed.innerHTML = `<div class="empty">${escapeHtml(error.message)}</div>`;
  }
}

function openPlayer(videoId, title, externalUrl) {
  if (!/^[A-Za-z0-9_-]{11}$/.test(videoId || "")) return;
  playerTitle.textContent = title || "YouTubeで再生";
  youtubePlayer.src = `https://www.youtube.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`;
  openYouTube.href = externalUrl || `https://www.youtube.com/watch?v=${encodeURIComponent(videoId)}`;
  playerModal.classList.remove("hidden");
  document.body.classList.add("modal-open");
}

function closePlayer() {
  youtubePlayer.src = "";
  playerModal.classList.add("hidden");
  document.body.classList.remove("modal-open");
}

function formatDate(value) {
  if (!value) return "";
  return new Intl.DateTimeFormat("ja-JP", {
    year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit"
  }).format(new Date(value));
}

function decodeEntities(value) {
  const textarea = document.createElement("textarea");
  textarea.innerHTML = String(value ?? "");
  return textarea.value;
}

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

loadPosts();

</script>
<!-- TRAVEL_LOG_SPOTS_UPLOAD_PATCH_V1 -->
<style>
  #travelSpotNameField { margin-top: 2px; }
  #travelSpotNameField input { width: 100%; }
  .travel-post-note {
    margin: 8px 0 0;
    color: #8a7f85;
    font-size: 11px;
    line-height: 1.6;
  }
</style>
<script>
(() => {
  function storageToken() {
    const stores = [window.localStorage, window.sessionStorage];
    const keys = [
      "access_token", "accessToken", "token", "auth_token",
      "authToken", "jwt", "jwt_token", "bearer_token"
    ];

    for (const store of stores) {
      if (!store) continue;

      for (const key of keys) {
        let value = store.getItem(key);
        if (!value) continue;

        value = String(value).trim();

        try {
          const obj = JSON.parse(value);
          value =
            obj?.access_token ||
            obj?.accessToken ||
            obj?.token ||
            obj?.jwt ||
            value;
        } catch (_) {}

        if (value && value !== "null" && value !== "undefined") {
          return value.replace(/^Bearer\s+/i, "");
        }
      }

      for (let i = 0; i < store.length; i++) {
        const key = store.key(i);
        if (!key) continue;
        const lower = key.toLowerCase();
        if (!lower.includes("token") && !lower.includes("auth")) continue;

        let value = store.getItem(key);
        if (!value) continue;

        try {
          const obj = JSON.parse(value);
          value =
            obj?.access_token ||
            obj?.accessToken ||
            obj?.token ||
            obj?.jwt ||
            "";
        } catch (_) {}

        if (value) return String(value).replace(/^Bearer\s+/i, "");
      }
    }
    return "";
  }

  function installTitleField() {
    const form = document.getElementById("postForm");
    if (!form || document.getElementById("travelSpotName")) return;

    const caption = form.querySelector('textarea[name="caption"]');
    const captionField = caption?.closest("label.field");

    const field = document.createElement("label");
    field.className = "field";
    field.id = "travelSpotNameField";
    field.innerHTML = `
      <span class="field-label">繧ｹ繝昴ャ繝亥錐 / 繧ｿ繧､繝医Ν</span>
      <input
        id="travelSpotName"
        type="text"
        maxlength="120"
        placeholder="萓具ｼ壼ｺ・ｮ蛾㈹豬ｷ豌ｴ豬ｴ蝣ｴ / 驥懷ｱｱ DAY1"
        required
      />
      <span class="travel-post-note">繝帙・繝逕ｻ髱｢縺ｫ陦ｨ遉ｺ縺輔ｌ繧区兜遞ｿ繧ｿ繧､繝医Ν縺ｧ縺吶・/span>
    `;

    if (captionField) captionField.before(field);
    else form.prepend(field);
  }

  async function submitTravelLog(event) {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || form.id !== "postForm") return;

    // The old demo handler posts to /api/posts. Stop it completely.
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    const submitButton = form.querySelector('button[type="submit"]');
    const originalText = submitButton?.textContent || "謚慕ｨｿ縺吶ｋ";

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "謚慕ｨｿ荳ｭ...";
    }

    try {
      const image = document.getElementById("image")?.files?.[0];
      const caption = form.querySelector('textarea[name="caption"]')?.value?.trim() || "";
      const title =
        document.getElementById("travelSpotName")?.value?.trim() ||
        caption.slice(0, 80) ||
        "Music Log";

      if (!image) throw new Error("蜀咏悄繧帝∈謚槭＠縺ｦ縺上□縺輔＞縲・);

      const data = new FormData();
      data.append("name", title);
      data.append("memo", caption);
      data.append("visited_at", new Date().toISOString());
      data.append("file", image, image.name);

      // Preserve the selected YouTube music in the post memo.
      // The current Travel Log /spots/upload endpoint does not yet have
      // dedicated music columns, so this keeps the music information
      // together with the post without breaking the existing database.
      if (typeof selectedVideo !== "undefined" && selectedVideo) {
        const musicTitle = decodeEntities(selectedVideo.title || "");
        const artist = decodeEntities(selectedVideo.artist || "");
        const url =
          selectedVideo.external_url ||
          (selectedVideo.youtube_video_id
            ? `https://www.youtube.com/watch?v=${selectedVideo.youtube_video_id}`
            : "");

        const musicText =
          `\n\n七 ${musicTitle}` +
          (artist ? ` 窶・${artist}` : "") +
          (url ? `\n${url}` : "");

        data.set("memo", `${caption}${musicText}`.trim());
      }

      const headers = {};
      const token = storageToken();
      if (token) headers.Authorization = `Bearer ${token}`;

      let response = await fetch("/spots/upload", {
        method: "POST",
        headers,
        body: data,
        credentials: "same-origin"
      });

      // If the page uses a browser session rather than localStorage bearer auth,
      // the request above already includes cookies. Give a clear message on 401.
      let payload = null;
      const raw = await response.text();
      try { payload = raw ? JSON.parse(raw) : {}; } catch (_) { payload = { detail: raw }; }

      if (!response.ok) {
        if (response.status === 401 || response.status === 403) {
          throw new Error("繝ｭ繧ｰ繧､繝ｳ諠・ｱ繧堤｢ｺ隱阪〒縺阪∪縺帙ｓ縺ｧ縺励◆縲ゅ・繝ｼ繝縺ｫ謌ｻ縺｣縺ｦ繝ｭ繧ｰ繧､繝ｳ縺礼峩縺励※縺上□縺輔＞縲・);
        }
        throw new Error(
          payload?.detail ||
          payload?.message ||
          `謚慕ｨｿ縺ｫ螟ｱ謨励＠縺ｾ縺励◆ (HTTP ${response.status})`
        );
      }

      // Success: return to the real Travel Log home/feed.
      window.location.assign("/");
    } catch (error) {
      alert(error?.message || "謚慕ｨｿ縺ｫ螟ｱ謨励＠縺ｾ縺励◆縲・);
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = originalText;
      }
    }
  }

  function hideDemoFeed() {
    const feed = document.getElementById("feed");
    const section = feed?.closest("section");
    if (section) section.style.display = "none";
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      installTitleField();
      hideDemoFeed();
    });
  } else {
    installTitleField();
    hideDemoFeed();
  }

  // Capture phase makes this run before the old /api/posts handler.
  document.addEventListener("submit", submitTravelLog, true);
})();
</script>
</body>
</html>

